using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: C_("shortcut window", "General");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Start or Pause");
      action-name: "app.sound-control";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Tap");
      action-name: "win.tap";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Increase BPM");
      action-name: "win.increase-bpm";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Decrease BPM");
      action-name: "win.decrease-bpm";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Increase BPM by 5");
      action-name: "win.increase-bpm-fast";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Decrease BPM by 5");
      action-name: "win.decrease-bpm-fast";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Quit");
      action-name: "app.quit";
    }
  }
}
