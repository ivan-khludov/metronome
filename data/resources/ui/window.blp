using Gtk 4.0;
using Adw 1;

template $MtrApplicationWindow : Adw.ApplicationWindow {
  default-width: 478;
  width-request: 478;

  styles [
    "application",
    "metronome",
  ]

  Overlay {
    WindowHandle {
    Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        show-end-title-buttons: false;
        show-start-title-buttons: false;
        show-title: false;

        [start]
        Box {
          spacing: 8;
          valign: center;

          Box {
            height-request: 12;
            valign: center;
            width-request: 12;

            styles [
              "title-dot",
            ]
          }

          Label {
            label: _("Metronome");
            valign: center;

            styles [
              "window-title",
            ]
          }
        }

        [end]
        Box {
          spacing: 8;
          valign: center;

          Button {
            action-name: "app.shortcuts";
            height-request: 24;
            label: "?";
            width-request: 24;

            styles [
              "help-button",
            ]
          }

          Box {
            spacing: 4;
            valign: center;

            styles [
              "window-controls",
            ]

            Button {
              clicked => $on_minimize_clicked() swapped;
              height-request: 20;
              width-request: 20;

              styles [
                "window-control",
              ]

              Image {
                height-request: 16;
                resource: "/io/github/ivan_khludov/metronome/icons/minimize.svg";
                width-request: 16;
              }
            }

            Button {
              clicked => $on_maximize_clicked() swapped;
              height-request: 20;
              width-request: 20;

              styles [
                "window-control",
              ]

              Image maximize_icon {
                height-request: 16;
                resource: "/io/github/ivan_khludov/metronome/icons/maximize.svg";
                width-request: 16;
              }
            }

            Button {
              clicked => $on_close_clicked() swapped;
              height-request: 20;
              width-request: 20;

              styles [
                "window-control",
                "close",
              ]

              Image {
                height-request: 16;
                resource: "/io/github/ivan_khludov/metronome/icons/close.svg";
                width-request: 16;
              }
            }
          }
        }
      }

      content: Box {
        hexpand: true;
        orientation: horizontal;
        vexpand: true;

        Box {
          hexpand: true;
        }

        Box {
          halign: fill;
          hexpand: false;
          orientation: vertical;
          overflow: visible;
          spacing: 24;
          valign: center;
          width-request: 478;

          styles [
            "app-column",
          ]

            Box time_signature {
              halign: fill;
              hexpand: true;
              orientation: vertical;

              styles [
                "time-signature",
              ]

              Label {
                halign: start;
                label: _("Time Signature");

                styles [
                  "section-label",
                ]
              }

              Grid time_signature_meters {
                column-homogeneous: true;
                column-spacing: 10;
                halign: fill;
                hexpand: true;
                row-homogeneous: true;
                row-spacing: 10;
                valign: start;
              }

              Button time_signature_add_button {
                clicked => $on_add_time_signature_clicked() swapped;
                halign: fill;
                height-request: 56;
                hexpand: true;
                tooltip-text: _("Add Time Signature");
                valign: fill;

                styles [
                  "meter-add",
                ]

                Image {
                  height-request: 20;
                  resource: "/io/github/ivan_khludov/metronome/icons/plus.svg";
                  width-request: 20;
                }
              }
            }

            Box {
              orientation: vertical;
              spacing: 24;

              styles [
                "display",
                "tempo-card",
              ]

              Button {
                clicked => $on_tempo_marking_clicked() swapped;
                halign: start;
                hexpand: false;
                tooltip-text: _("Tempo");

                styles [
                  "tempo-marking",
                ]

                Box {
                  spacing: 6;

                  Label tempo_marking {
                    label: "Moderato";

                    styles [
                      "tempo-name",
                    ]
                  }

                  Image {
                    height-request: 12;
                    resource: "/io/github/ivan_khludov/metronome/icons/chevron.svg";
                    width-request: 12;
                  }
                }
              }

              Box {
                styles [
                  "bpm-row",
                ]

                Button {
                  action-name: "win.decrease-bpm";
                  height-request: 48;
                  label: "−";
                  tooltip-text: _("Decrease BPM (Down)");
                  valign: center;
                  width-request: 48;

                  styles [
                    "bpm-step",
                  ]
                }

                Box {
                  halign: center;
                  hexpand: true;
                  orientation: vertical;
                  valign: center;

                  Label {
                    halign: center;
                    label: bind template.beats-per-minute;
                    width-chars: 3;

                    styles [
                      "bpm-value",
                    ]
                  }

                  Label {
                    halign: center;
                    label: _("BPM");

                    styles [
                      "bpm-caption",
                    ]
                  }
                }

                Button {
                  action-name: "win.increase-bpm";
                  height-request: 48;
                  label: "+";
                  tooltip-text: _("Increase BPM (Up)");
                  valign: center;
                  width-request: 48;

                  styles [
                    "bpm-step",
                  ]
                }
              }

              Scale {
                adjustment: bpm_adjustment;
                digits: 0;

                marks [
                  mark (20, bottom, "20"),
                  mark (80, bottom, "80"),
                  mark (140, bottom, "140"),
                  mark (200, bottom, "200"),
                  mark (260, bottom, "260"),
                ]
              }
            }

            Box controls {
              hexpand: true;
              overflow: visible;

              styles [
                "controls",
              ]

              Button {
                action-name: "win.tap";
                halign: start;
                height-request: 56;
                label: _("TAP");
                tooltip-text: _("Tap (T)");
                valign: center;
                width-request: 56;

                styles [
                  "transport",
                ]
              }

              Box {
                hexpand: true;
              }

              $MtrTimerButton timer_button {
                accent-pattern: bind template.accent-pattern;
                beats-per-bar: bind template.beats-per-bar;
                beats-per-minute: bind template.beats-per-minute;
                halign: center;
                height-request: 80;
                valign: center;
                width-request: 80;
              }

              Box {
                hexpand: true;
              }

              Button {
                clicked => $on_edit_time_signature_clicked() swapped;
                halign: end;
                height-request: 56;
                tooltip-text: _("Edit Time Signature");
                valign: center;
                width-request: 56;

                styles [
                  "transport",
                ]

                Image {
                  height-request: 24;
                  resource: "/io/github/ivan_khludov/metronome/icons/dots.svg";
                  width-request: 24;
                }
              }
            }
          }

        Box {
          hexpand: true;
        }
      };
    }
  }

  [overlay]
  Box window_dimmer {
    hexpand: true;
    vexpand: true;
    visible: false;

    styles [
      "window-dimmer",
    ]
  }
  }
}

Adjustment bpm_adjustment {
  lower: 20;
  upper: 260;
  page-increment: 10;
  step-increment: 1;
  value: bind template.beats-per-minute bidirectional;
}

$MtrTimer timer {
  accent-pattern: bind template.accent-pattern;
  active: bind timer_button.active;
  beats-per-bar: bind template.beats-per-bar;
  beats-per-minute: bind template.beats-per-minute;
}
