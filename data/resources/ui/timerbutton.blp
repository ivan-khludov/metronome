using Gtk 4.0;

template $MtrTimerButton : Widget {
  overflow: visible;

  $MtrTimerButtonTrough trough {
    overflow: "hidden";
  }

  Box marks_container {
    halign: center;
    homogeneous: true;
    orientation: vertical;

    $GtkGizmo {}

    Overlay marks_overlay {}
  }

  Stack stack {
    halign: center;
    valign: center;

    Button start_button {
      height-request: 80;
      tooltip-text: _("Play (Space)");
      width-request: 80;
      clicked => $start() swapped;

      styles [
        "circular",
        "image-button",
        "play-start",
      ]

      Image {
        resource: "/io/github/ivan_khludov/metronome/icons/play.svg";
        width-request: 36;
        height-request: 36;
      }
    }

    Button pause_button {
      height-request: 80;
      tooltip-text: _("Pause (Space)");
      width-request: 80;
      clicked => $pause() swapped;

      styles [
        "circular",
        "image-button",
      ]

      Image {
        resource: "/io/github/ivan_khludov/metronome/icons/pause.svg";
        width-request: 36;
        height-request: 36;
      }
    }
  }
}
