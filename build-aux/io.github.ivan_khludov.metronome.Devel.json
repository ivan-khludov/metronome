{
    "id": "io.github.ivan_khludov.metronome.Devel",
    "runtime": "org.gnome.Platform",
    "runtime-version": "master",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "metronome",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri",
        "--env=RUST_LOG=metronome=debug",
        "--env=G_MESSAGES_DEBUG=none"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "test-args": [
            "--socket=x11"
        ],
        "env": {
            "CARGO_NET_OFFLINE": "true",
            "RUST_BACKTRACE": "1"
        }
    },
    "modules": [
        {
            "name": "blueprint-compiler",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/jwestman/blueprint-compiler",
                    "tag": "v0.8.1"
                }
            ]
        },
        {
            "name": "metronome",
            "buildsystem": "meson",
            "run-tests": true,
            "config-opts": [
                "-Dprofile=development"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../"
                },
                "cargo-sources.json"
            ]
        }
    ]
}